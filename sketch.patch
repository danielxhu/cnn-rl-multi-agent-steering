+def _circle_fit(xs, ys):
+    """Algebraic (Kåsa) circle fit -> centre (x, y)."""
+    A = np.c_[xs, ys, np.ones_like(xs)]
+    sol = np.linalg.lstsq(A, xs * xs + ys * ys, rcond=None)[0]
+    return sol[0] / 2, sol[1] / 2
+
